# Server configuration
PORT=5001
NODE_ENV=development

# AWS Configuration (Leave blank or fill with your AWS IAM credentials)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3 Configuration
S3_BUCKET_NAME=healthlens-reports-bucket

# DynamoDB Tables
DYNAMODB_REPORTS_TABLE=HealthLensReports
DYNAMODB_MEASUREMENTS_TABLE=HealthLensMeasurements

# Amazon Bedrock Model (Claude 3 Haiku / Claude 3 Sonnet / Amazon Nova)
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Mode override: set to 'live' to require AWS, or 'auto' (default) to fallback to local simulation when keys are not set
AWS_MODE=auto
